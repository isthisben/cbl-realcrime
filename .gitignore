# Cached GeoJSON (downloaded on first run). The committed copy below is
# shipped for hosting so the server needs no network on boot.
data/*.geojson
!data/pfa_2023_buc.geojson

# Pre-computed dataset cache (pickled; regenerated from the raw files on
# demand via `python data.py`, or automatically whenever a source changes)
data/cache/

# Raw Home Office ODS files are committed (see data/raw/SOURCES.md) so the
# dataset reproduces from source. They are kept out of the Docker image via
# .dockerignore — the deploy runs off the committed snapshot in data/snapshot/.

# Generated shareable assets (regenerate via `python build_assets.py`)
exports/

